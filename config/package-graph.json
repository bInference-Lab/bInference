{
  "scope": "@binference",
  "allowEverywhere": ["zod"],
  "packages": {
    "core": {
      "imports": [],
      "pure": true
    },
    "chain": {
      "imports": ["core"],
      "pure": true,
      "money": true,
      "coverage": 95
    },
    "chain-evm": {
      "imports": ["core", "chain", "chains", "viem", "@noble/curves"],
      "only": {
        "@binference/chains": "src/fork"
      },
      "money": true,
      "coverage": 95
    },
    "chains": {
      "imports": ["core", "chain"],
      "money": true
    },
    "platform": {
      "imports": ["core", "execa", "which-command", "@napi-rs/keyring", "undici"],
      "only": {
        "undici": "src/outbound"
      },
      "osLayer": true,
      "fileSystem": true
    },
    "store": {
      "imports": ["core", "chain", "engine", "kysely", "pg"],
      "fileSystem": true
    },
    "protocol": {
      "imports": ["core", "chain"],
      "pure": true,
      "money": true,
      "publish": true
    },
    "i18n": {
      "imports": ["core", "chain", "protocol", "intl-messageformat"],
      "pure": true,
      "formatsDisplay": true
    },
    "engine": {
      "imports": ["core", "chain", "protocol", "i18n"],
      "pure": true,
      "money": true,
      "coverage": 95,
      "mutation": true
    },
    "signer": {
      "imports": ["core", "chain", "@privy-io/node"],
      "only": {
        "@privy-io/node": "src/privy-sdk"
      },
      "money": true,
      "coverage": 95,
      "mutation": true
    },
    "custody-privy": {
      "imports": [
        "core",
        "chain",
        "chain-evm",
        "platform",
        "@privy-io/node",
        "viem",
        "@hpke/core",
        "@hpke/chacha20poly1305"
      ],
      "only": {
        "@binference/platform": "src/contracts",
        "viem": "src/testing",
        "@hpke/core": "src/testing",
        "@hpke/chacha20poly1305": "src/testing"
      },
      "money": true
    },
    "server": {
      "imports": ["core", "protocol", "engine", "ws", "client"],
      "only": {
        "@binference/client": "src/e2e"
      },
      "httpListener": true
    },
    "telegram": {
      "imports": [
        "core",
        "chain",
        "protocol",
        "i18n",
        "engine",
        "grammy",
        "qr",
        "rich-text",
        "chart"
      ],
      "userText": true
    },
    "client": {
      "imports": ["core", "protocol"],
      "publish": true
    },
    "runtime": {
      "imports": [
        "core",
        "protocol",
        "chart",
        "client",
        "i18n",
        "store",
        "platform",
        "ws",
        "openai",
        "@anthropic-ai/sdk",
        "partial-json",
        "yaml"
      ],
      "only": {
        "@binference/platform": "src/process",
        "openai": "src/providers",
        "@anthropic-ai/sdk": "src/providers"
      }
    },
    "tui": {
      "imports": ["core", "client", "protocol", "i18n", "rich-text", "chart", "string-width"],
      "userText": true
    },
    "console": {
      "imports": [
        "client",
        "protocol",
        "i18n",
        "rich-text",
        "chart",
        "react",
        "react-dom",
        "@tanstack/react-router",
        "@tanstack/react-query",
        "@base-ui/react",
        "lucide-react",
        "class-variance-authority",
        "cn",
        "@fontsource-variable/hanken-grotesk",
        "tailwindcss",
        "@tailwindcss/vite",
        "vite",
        "@vitejs/plugin-react",
        "jsdom",
        "@testing-library/react",
        "@testing-library/dom",
        "fake-indexeddb",
        "@playwright/test"
      ],
      "only": {
        "@playwright/test": "src/smoke"
      },
      "userText": true,
      "browser": true
    },
    "mcp": {
      "imports": [
        "client",
        "protocol",
        "@modelcontextprotocol/server",
        "@modelcontextprotocol/client"
      ],
      "only": {
        "@modelcontextprotocol/client": "src/e2e"
      }
    },
    "plugin-sdk": {
      "imports": ["core", "chain", "protocol", "chain-evm"],
      "publish": true
    },
    "cli": {
      "name": "binference",
      "imports": ["*"],
      "compositionRoot": true,
      "publish": true
    },
    "chain-solana": {
      "imports": ["core", "chain", "@solana/kit"],
      "money": true,
      "coverage": 95
    },
    "plugin-host": {
      "imports": ["core", "platform", "plugin-sdk"]
    },
    "qr": {
      "imports": ["qr"],
      "pure": true
    },
    "rich-text": {
      "imports": [],
      "pure": true
    },
    "chart": {
      "imports": ["protocol"],
      "pure": true
    },
    "browser": {
      "imports": ["core", "protocol", "engine", "platform", "playwright-core"],
      "fileSystem": true
    },
    "pdf": {
      "imports": ["core", "protocol", "engine", "pdfjs-dist", "@napi-rs/canvas"]
    }
  },
  "plugins": {
    "imports": ["plugin-sdk", "chain-evm"],
    "only": {
      "@binference/chain-evm": "*/src/fork"
    },
    "anyThirdParty": true
  }
}
