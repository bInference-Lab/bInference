{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // check:store loads its Oxlint plugin by path.
      "entry": ["scripts/*.mts", "config/oxlint/store-guards.mjs"],
      "project": ["scripts/**/*.mts", "config/**/*.{ts,mjs}", "*.config.{ts,mts,mjs}"],
    },
    "{packages,plugins}/*": {
      "project": ["src/**/*.ts"],
    },
    // Worker entries load by URL, so no import names them.
    "packages/store": {
      "entry": ["src/**/*.worker.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/telegram": {
      "entry": ["src/**/*.worker.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  // Installed in CI from pinned releases; neither is an npm package. anvil serves the fork suite.
  "ignoreBinaries": ["opengrep", "anvil"],
  "ignoreDependencies": [
    // knip's Stryker plugin asks for this runner, but it ships inside @stryker-mutator/core.
    "@stryker-mutator/command-runner",
  ],
}
