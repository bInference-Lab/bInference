{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // check:store loads its Oxlint plugin by path.
      "entry": ["scripts/*.mts", "config/oxlint/store-guards.mjs"],
      "project": ["scripts/**/*.mts", "config/**/*.{ts,mjs}", "*.config.{ts,mts,mjs}"],
    },
    "{packages,plugins}/*": {
      "project": ["src/**/*.ts"],
    },
    // Worker entries load by URL, so no import names them.
    "packages/store": {
      "entry": ["src/**/*.worker.ts"],
      "project": ["src/**/*.ts"],
    },
    // The recorded run's MCP server starts by its path, from scripts/skill-run.mts.
    "packages/cli": {
      "entry": ["src/skill-run/skill-run-server.ts"],
      "project": ["src/**/*.ts"],
    },
    // The console is a Vite app: index.html loads its entry and its stylesheet. Its shadcn
    // components stay as the shadcn CLI writes them, every one whether used yet or not.
    "packages/console": {
      "entry": ["src/app/theme.css"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/components/ui/**"],
    },
    "packages/telegram": {
      "entry": ["src/**/*.worker.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  // Installed in CI from a pinned release; it is no npm package. anvil serves the fork and crash
  // suites.
  "ignoreBinaries": ["anvil"],
  "ignoreDependencies": [
    // knip's Stryker plugin asks for this runner, but it ships inside @stryker-mutator/core.
    "@stryker-mutator/command-runner",
  ],
}
