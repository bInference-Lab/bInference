{
  "name": "binference-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The binference monorepo: an open-source AI agent that trades on BNB Smart Chain",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run build format:check lint typecheck check:package-graph check:tsconfig check:style check:layout check:suppressions check:deps-policy check:tsdoc check:contract-suites check:chain-literals check:protocol-compat check:store check:config-schema check:i18n check:adr check:docs lint:docs deadcode dup:check test check:gates --output-logs=errors-only",
    "check:adr": "node --import tsx scripts/check-adr.mts",
    "check:chain-literals": "node --import tsx scripts/check-chain-literals.mts",
    "check:config-schema": "node --conditions=@binference/source --import tsx scripts/check-config-schema.mts",
    "check:contract-suites": "node --import tsx scripts/check-contract-suites.mts",
    "check:deps-policy": "node --import tsx scripts/check-deps-policy.mts",
    "check:docs": "node --import tsx scripts/check-docs.mts",
    "check:gates": "node --import tsx scripts/check-gates.mts",
    "check:i18n": "node --conditions=@binference/source --import tsx scripts/check-i18n.mts",
    "check:layout": "node --import tsx scripts/check-layout.mts",
    "check:package-graph": "node --import tsx scripts/check-package-graph.mts",
    "check:pr": "node --import tsx scripts/check-pr.mts",
    "check:protocol-compat": "node --conditions=@binference/source --import tsx scripts/check-protocol-compat.mts",
    "check:store": "node --import tsx scripts/check-store.mts",
    "check:style": "node --import tsx scripts/check-style.mts",
    "check:suppressions": "node --import tsx scripts/check-suppressions.mts",
    "check:tsconfig": "node --import tsx scripts/check-tsconfig.mts",
    "check:tsdoc": "node --import tsx scripts/check-tsdoc.mts",
    "commitlint": "commitlint",
    "deadcode": "knip --no-progress",
    "dup:check": "jscpd .",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "gen:package": "node --import tsx scripts/gen-package.mts",
    "lint": "oxlint --type-aware --tsconfig tsconfig.json --report-unused-disable-directives-severity error",
    "lint:docs": "markdownlint-cli2",
    "mutation": "stryker run",
    "mutation:summary": "node --import tsx scripts/mutation-summary.mts",
    "security:audit": "pnpm audit --audit-level=high",
    "security:opengrep": "node --import tsx scripts/scan-opengrep.mts",
    "setup": "node --import tsx scripts/setup.mts",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@binference/i18n": "workspace:*",
    "@binference/protocol": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/types": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "binference": "workspace:*",
    "fast-check": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.1"
  },
  "packageManager": "pnpm@12.8.1"
}
