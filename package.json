{
  "name": "binference-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The binference monorepo: an open-source AI agent that trades on BNB Smart Chain",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:gates",
    "check:gates": "node --import tsx scripts/check-gates.mts",
    "gen:package": "node --import tsx scripts/gen-package.mts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.1"
  },
  "packageManager": "pnpm@12.8.1"
}
