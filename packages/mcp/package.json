{
  "name": "@binference/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "The MCP server: the engine's read and propose tools for any MCP client, over stdio.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/client": "workspace:*",
    "@binference/protocol": "workspace:*",
    "zod": "catalog:"
  }
}
