{
  "name": "@binference/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Domain and use cases: intents, policy, risk, confirmations, wallet queues, orders, watchers, ledger and paper mode.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./wallet-queue": {
      "@binference/source": "./src/wallet-queue.ts",
      "types": "./dist/wallet-queue.d.mts",
      "default": "./dist/wallet-queue.mjs"
    },
    "./simulation": {
      "@binference/source": "./src/simulation.ts",
      "types": "./dist/simulation.d.mts",
      "default": "./dist/simulation.mjs"
    },
    "./risk": {
      "@binference/source": "./src/risk.ts",
      "types": "./dist/risk.d.mts",
      "default": "./dist/risk.mjs"
    },
    "./approval": {
      "@binference/source": "./src/approval.ts",
      "types": "./dist/approval.d.mts",
      "default": "./dist/approval.mjs"
    },
    "./surfaces": {
      "@binference/source": "./src/surfaces.ts",
      "types": "./dist/surfaces.d.mts",
      "default": "./dist/surfaces.mjs"
    },
    "./backups": {
      "@binference/source": "./src/backups.ts",
      "types": "./dist/backups.d.mts",
      "default": "./dist/backups.mjs"
    },
    "./install": {
      "@binference/source": "./src/install.ts",
      "types": "./dist/install.d.mts",
      "default": "./dist/install.mjs"
    },
    "./executor": {
      "@binference/source": "./src/executor.ts",
      "types": "./dist/executor.d.mts",
      "default": "./dist/executor.mjs"
    },
    "./sends": {
      "@binference/source": "./src/sends.ts",
      "types": "./dist/sends.d.mts",
      "default": "./dist/sends.mjs"
    },
    "./audit": {
      "@binference/source": "./src/audit.ts",
      "types": "./dist/audit.d.mts",
      "default": "./dist/audit.mjs"
    },
    "./safety": {
      "@binference/source": "./src/safety.ts",
      "types": "./dist/safety.d.mts",
      "default": "./dist/safety.mjs"
    },
    "./outflows": {
      "@binference/source": "./src/outflows.ts",
      "types": "./dist/outflows.d.mts",
      "default": "./dist/outflows.mjs"
    },
    "./notices": {
      "@binference/source": "./src/notices.ts",
      "types": "./dist/notices.d.mts",
      "default": "./dist/notices.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts src/wallet-queue.ts src/simulation.ts src/risk.ts src/approval.ts src/surfaces.ts src/install.ts src/executor.ts src/sends.ts src/audit.ts src/safety.ts src/outflows.ts src/notices.ts src/backups.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/core": "workspace:*",
    "@binference/i18n": "workspace:*",
    "@binference/protocol": "workspace:*",
    "zod": "catalog:"
  }
}
