{
  "name": "@binference/protocol",
  "version": "0.0.0",
  "description": "The engine protocol as zod schemas: frames, credentials, ids, error codes and versions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bInference-Lab/bInference.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "NOTICES.md",
    "README.zh.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/core": "workspace:*",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.1"
  }
}
