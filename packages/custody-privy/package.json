{
  "name": "@binference/custody-privy",
  "version": "0.0.0",
  "private": true,
  "description": "The privy-owner custody adapter: key quorums, the ceiling, agent wallets and signing calls through Privy's API.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/chain-evm": "workspace:*",
    "@binference/core": "workspace:*",
    "@privy-io/node": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  }
}
