{
  "name": "@binference/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "The agent's PDF reader on the owner's machine: each page's text, and a JPEG of each scanned page, read with pdf.js in a worker thread.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/pdf.worker.ts --unbundle --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/core": "workspace:*",
    "@binference/engine": "workspace:*",
    "@binference/protocol": "workspace:*",
    "@napi-rs/canvas": "catalog:",
    "pdfjs-dist": "catalog:",
    "zod": "catalog:"
  }
}
