{
  "name": "@binference/plugin-sdk",
  "version": "0.0.0",
  "description": "What plugins import: defineVenue, the venue types, their contract suites and each chain family's helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bInference-Lab/bInference.git",
    "directory": "packages/plugin-sdk"
  },
  "files": [
    "dist",
    "NOTICES.md",
    "README.zh.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./community": {
      "@binference/source": "./src/community.ts",
      "types": "./dist/community.d.mts",
      "default": "./dist/community.mjs"
    },
    "./data": {
      "@binference/source": "./src/data.ts",
      "types": "./dist/data.d.mts",
      "default": "./dist/data.mjs"
    },
    "./evm": {
      "@binference/source": "./src/evm.ts",
      "types": "./dist/evm.d.mts",
      "default": "./dist/evm.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts src/community.ts src/data.ts src/evm.ts src/testing.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/chain-evm": "workspace:*",
    "@binference/core": "workspace:*",
    "@binference/protocol": "workspace:*",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.1"
  }
}
