{
  "name": "@binference/chain-solana",
  "version": "0.0.0",
  "private": true,
  "description": "The Solana chain family, read only: the base58 codec for 32-byte addresses and the delivery read over Solana's JSON-RPC.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/core": "workspace:*",
    "@solana/kit": "catalog:",
    "zod": "catalog:"
  }
}
