{
  "name": "@binference/chain-evm",
  "version": "0.0.0",
  "private": true,
  "description": "The EVM chain family: viem clients behind RPC failover, fees, simulation with transfer traces, calldata decoding and the EVM signing scheme.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/core": "workspace:*",
    "@noble/curves": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binference/chains": "workspace:*"
  }
}
