{
  "name": "@binference/telegram",
  "version": "0.0.0",
  "private": true,
  "description": "The Telegram channel: durable update intake, owner pairing, and secret screening for the owner's bot.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/core": "workspace:*",
    "@binference/engine": "workspace:*",
    "zod": "catalog:"
  }
}
