{
  "name": "@binference/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "The agent runtime: the process the engine starts to run each agent's model loop, sessions and tools.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./process": {
      "@binference/source": "./src/process/runtime-process.ts",
      "default": "./dist/runtime-process.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@binference/client": "workspace:*",
    "@binference/core": "workspace:*",
    "@binference/protocol": "workspace:*",
    "@binference/store": "workspace:*",
    "openai": "catalog:",
    "undici": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "catalog:"
  }
}
