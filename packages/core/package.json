{
  "name": "@binference/core",
  "version": "0.0.0",
  "private": true,
  "description": "Results, errors, branded ids, amount math, retry, and the Clock, Random, Logger and Http ports.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
