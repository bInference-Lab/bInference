{
  "name": "@binference/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Every word binference shows, in English and Simplified Chinese, and the one formatter for messages, amounts and times.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./check": {
      "@binference/source": "./src/check.ts",
      "types": "./dist/check.d.mts",
      "default": "./dist/check.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/check.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/core": "workspace:*",
    "intl-messageformat": "catalog:"
  }
}
