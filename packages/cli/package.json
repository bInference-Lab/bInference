{
  "name": "binference",
  "version": "0.0.0",
  "private": true,
  "description": "The binference command and the composition root: start, status, health and logs, the config and the self-hosted engine.",
  "license": "MIT",
  "bin": {
    "binference": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/main.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/chain": "workspace:*",
    "@binference/chain-evm": "workspace:*",
    "@binference/chains": "workspace:*",
    "@binference/client": "workspace:*",
    "@binference/core": "workspace:*",
    "@binference/engine": "workspace:*",
    "@binference/i18n": "workspace:*",
    "@binference/platform": "workspace:*",
    "@binference/protocol": "workspace:*",
    "@binference/server": "workspace:*",
    "@binference/store": "workspace:*",
    "@binference/telegram": "workspace:*",
    "commander": "catalog:",
    "grammy": "catalog:",
    "json5": "catalog:",
    "tslog": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "catalog:",
    "viem": "catalog:"
  }
}
