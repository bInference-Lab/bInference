{
  "name": "@binference/platform",
  "version": "0.0.0",
  "private": true,
  "description": "The OS layer: the state folder, owner-only files, the engine lock, IPC endpoints and the shutdown sequence.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./outbound": {
      "@binference/source": "./src/outbound/outbound-pools.ts",
      "types": "./dist/outbound/outbound-pools.d.mts",
      "default": "./dist/outbound/outbound-pools.mjs"
    },
    "./client-cert-http": {
      "@binference/source": "./src/outbound/client-cert-http.ts",
      "types": "./dist/outbound/client-cert-http.d.mts",
      "default": "./dist/outbound/client-cert-http.mjs"
    },
    "./image-shell": {
      "@binference/source": "./src/posix/image-shell.ts",
      "types": "./dist/posix/image-shell.d.mts",
      "default": "./dist/posix/image-shell.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts src/outbound/outbound-pools.ts src/outbound/client-cert-http.ts src/posix/image-shell.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/core": "workspace:*",
    "@napi-rs/keyring": "catalog:",
    "execa": "catalog:",
    "undici": "catalog:",
    "which-command": "catalog:",
    "zod": "catalog:"
  }
}
