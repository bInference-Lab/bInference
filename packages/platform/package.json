{
  "name": "@binference/platform",
  "version": "0.0.0",
  "private": true,
  "description": "The OS layer: the state folder, owner-only files, the engine lock, IPC endpoints and the shutdown sequence.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@binference/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "@binference/source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts --format esm --dts --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@binference/core": "workspace:*",
    "@napi-rs/keyring": "catalog:",
    "execa": "catalog:",
    "zod": "catalog:"
  }
}
