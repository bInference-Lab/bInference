{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck": {
      "outputs": []
    },
    "//#check:package-graph": {
      "outputs": []
    },
    "//#check:tsconfig": {
      "outputs": []
    },
    "//#check:style": {
      "outputs": []
    },
    "//#check:layout": {
      "outputs": []
    },
    "//#check:suppressions": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:deps-policy": {
      "outputs": []
    },
    "//#check:tsdoc": {
      "outputs": []
    },
    "//#check:contract-suites": {
      "outputs": []
    },
    "//#check:chain-literals": {
      "outputs": []
    },
    "//#check:protocol-compat": {
      "outputs": []
    },
    "//#check:adr": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:docs": {
      "outputs": []
    },
    "//#lint:docs": {
      "outputs": []
    },
    "//#deadcode": {
      "outputs": []
    },
    "//#dup:check": {
      "outputs": []
    },
    "//#test": {
      "outputs": ["coverage/**"]
    },
    "//#check:gates": {
      "outputs": [],
      "inputs": [
        "scripts/**",
        "config/**",
        ".agents/**",
        ".claude/**",
        ".github/**",
        "docs/DECISIONS.md",
        "docs/decisions.lock.json",
        "docs/adr/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "turbo.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "stryker.config.mjs",
        "commitlint.config.mts",
        "knip.jsonc",
        ".oxlintrc.json",
        ".oxfmtrc.jsonc",
        ".markdownlint-cli2.jsonc",
        ".jscpd.json",
        ".npmrc",
        "packages/*/package.json",
        "packages/*/tsconfig.json",
        "packages/*/snapshots/**",
        "plugins/*/package.json"
      ]
    }
  }
}
