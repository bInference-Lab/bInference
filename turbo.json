{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "messages/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck": {
      "outputs": []
    },
    "//#check:package-graph": {
      "outputs": []
    },
    "//#check:tsconfig": {
      "outputs": []
    },
    "//#check:style": {
      "outputs": []
    },
    "//#check:layout": {
      "outputs": []
    },
    "//#check:suppressions": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:deps-policy": {
      "outputs": []
    },
    "//#check:tsdoc": {
      "outputs": []
    },
    "//#check:contract-suites": {
      "outputs": []
    },
    "//#check:chain-literals": {
      "outputs": []
    },
    "//#check:protocol-compat": {
      "outputs": []
    },
    "//#check:i18n": {
      "outputs": [],
      "inputs": [
        "packages/i18n/messages/**",
        "packages/i18n/src/**",
        "packages/protocol/src/**",
        "docs/GLOSSARY.md",
        "scripts/check-i18n.mts",
        "pnpm-lock.yaml"
      ]
    },
    "//#check:config-schema": {
      "outputs": [],
      "inputs": [
        "packages/*/src/**",
        "!packages/*/src/**/*.test.ts",
        "packages/cli/snapshots/**",
        "packages/cli/docs/**",
        "scripts/check-config-schema.mts",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "//#check:store": {
      "outputs": [],
      "env": ["BASE_REF"],
      "inputs": [
        "packages/*/src/**",
        "plugins/*/src/**",
        "packages/store/migrations.lock.json",
        "scripts/check-store.mts",
        "scripts/store/**",
        "scripts/git-base.mts",
        "scripts/repo-files.mts",
        "scripts/run-command.mts",
        "scripts/run-plugin-rules.mts",
        "config/oxlint/store-guards.mjs",
        "config/oxlint/store-ast.mjs"
      ]
    },
    "//#check:adr": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:docs": {
      "outputs": []
    },
    "//#lint:docs": {
      "outputs": []
    },
    "//#deadcode": {
      "outputs": []
    },
    "//#dup:check": {
      "outputs": []
    },
    "//#test": {
      "outputs": ["coverage/**"]
    },
    "//#check:gates": {
      "outputs": [],
      "inputs": [
        "scripts/**",
        "config/**",
        ".agents/**",
        ".claude/**",
        ".github/**",
        "docs/DECISIONS.md",
        "docs/decisions.lock.json",
        "docs/adr/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "turbo.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "stryker.config.mjs",
        "commitlint.config.mts",
        "knip.jsonc",
        ".oxlintrc.json",
        ".oxfmtrc.jsonc",
        ".markdownlint-cli2.jsonc",
        ".jscpd.json",
        ".npmrc",
        "packages/*/package.json",
        "packages/*/tsconfig.json",
        "packages/*/snapshots/**",
        "plugins/*/package.json"
      ],
      "passThroughEnv": ["TMPDIR", "TEMP", "TMP"]
    }
  }
}
