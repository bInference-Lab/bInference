{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck": {
      "outputs": []
    },
    "//#check:package-graph": {
      "outputs": []
    },
    "//#check:tsconfig": {
      "outputs": []
    },
    "//#check:style": {
      "outputs": []
    },
    "//#check:layout": {
      "outputs": []
    },
    "//#check:suppressions": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:deps-policy": {
      "outputs": []
    },
    "//#check:tsdoc": {
      "outputs": []
    },
    "//#check:contract-suites": {
      "outputs": []
    },
    "//#check:adr": {
      "outputs": [],
      "env": ["BASE_REF"]
    },
    "//#check:docs": {
      "outputs": []
    },
    "//#lint:docs": {
      "outputs": []
    },
    "//#deadcode": {
      "outputs": []
    },
    "//#dup:check": {
      "outputs": []
    },
    "//#test": {
      "outputs": ["coverage/**"]
    },
    "//#check:gates": {
      "outputs": []
    }
  }
}
